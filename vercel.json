{
  "buildCommand": "echo 'Using prebuilt web assets'",
  "outputDirectory": "build/web",
  "installCommand": "echo 'Prebuilt web assets - skipping install'",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(assets/.*|main.dart.js|flutter.js|flutter_bootstrap.js|canvaskit/.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
